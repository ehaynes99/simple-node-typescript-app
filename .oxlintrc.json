{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist/**"],
  "jsPlugins": [
    { "name": "@stylistic", "specifier": "@stylistic/eslint-plugin" },
    { "name": "depend", "specifier": "eslint-plugin-depend" },
    { "name": "import-x-js", "specifier": "eslint-plugin-import-x" },
    { "name": "security", "specifier": "eslint-plugin-security" },
    { "name": "unused-imports", "specifier": "eslint-plugin-unused-imports" }
  ],
  "options": { "reportUnusedDisableDirectives": "error", "typeAware": true },
  "plugins": ["import", "oxc", "unicorn"],
  "rules": {
    "@stylistic/max-statements-per-line": ["error", { "max": 1 }],
    "@stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "next": "import", "prev": "*" },
      { "blankLine": "always", "next": "*", "prev": "import" },
      { "blankLine": "any", "next": "import", "prev": "import" }
    ],
    "@stylistic/spaced-comment": ["error", "always", { "block": { "balanced": true } }],
    "curly": ["error", "all"],
    "depend/ban-dependencies": "error",
    "eqeqeq": ["error", "always", { "null": "never" }],
    "import-x-js/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": ["**/eslint.config.{js,mjs}", "**/*.test.ts", "test/**", "vitest.config.ts"],
        "optionalDependencies": false
      }
    ],
    "import/first": "error",
    "import/no-duplicates": "error",
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-empty": "error",
    "no-eval": "error",
    "no-extra-boolean-cast": "off",
    "no-useless-rename": "error",
    "object-shorthand": "error",
    "prefer-promise-reject-errors": "error",
    "security/detect-bidi-characters": "error",
    "security/detect-buffer-noassert": "error",
    "security/detect-disable-mustache-escape": "error",
    "security/detect-eval-with-expression": "error",
    "security/detect-new-buffer": "error",
    "security/detect-pseudoRandomBytes": "error",
    "unicorn/catch-error-name": ["error", { "ignore": ["^err$", "^error_$", "[A-Za-z]+[Ee]rror$"] }],
    "unicorn/no-await-in-promise-methods": "error",
    "unicorn/no-single-promise-in-promise-methods": "error",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/prefer-node-protocol": "error",
    "unused-imports/no-unused-imports": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/consistent-test-it": ["error", { "fn": "it" }],
        "vitest/consistent-vitest-vi": ["error", { "fn": "vi" }],
        "vitest/expect-expect": "off",
        "vitest/no-commented-out-tests": "error",
        "vitest/no-conditional-expect": "off",
        "vitest/no-disabled-tests": "off",
        "vitest/no-duplicate-hooks": "error",
        "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error",
        "vitest/no-import-node-test": "error",
        "vitest/no-interpolation-in-snapshots": "error",
        "vitest/no-mocks-import": "off",
        "vitest/no-standalone-expect": "off",
        "vitest/no-test-prefixes": "error",
        "vitest/no-unneeded-async-expect-function": "error",
        "vitest/padding-around-after-all-blocks": "error",
        "vitest/prefer-called-exactly-once-with": "error",
        "vitest/prefer-hooks-on-top": "error",
        "vitest/prefer-to-contain": "error",
        "vitest/require-local-test-context-for-concurrent-snapshots": "off",
        "vitest/valid-describe-callback": "error",
        "vitest/valid-expect": "off",
        "vitest/valid-expect-in-promise": "error",
        "vitest/valid-title": "off"
      }
    },
    {
      "files": ["**/*.ts"],
      "plugins": ["typescript"],
      "rules": {
        "no-var": "error",
        "prefer-const": ["error", { "destructuring": "any", "ignoreReadBeforeAssign": false }],
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "typescript/await-thenable": "error",
        "typescript/ban-ts-comment": "error",
        "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
        "typescript/dot-notation": [
          "error",
          {
            "allowPattern": "^([a-z]+(_[a-z]+)+|[A-Z].*)$",
            "allowPrivateClassPropertyAccess": true,
            "allowProtectedClassPropertyAccess": true
          }
        ],
        "typescript/explicit-module-boundary-types": ["error", { "allowArgumentsExplicitlyTypedAsAny": true }],
        "typescript/no-array-constructor": "error",
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-import-type-side-effects": "error",
        "typescript/no-inferrable-types": ["error", { "ignoreParameters": true, "ignoreProperties": true }],
        "typescript/no-misused-new": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-namespace": ["error", { "allowDeclarations": true, "allowDefinitionFiles": true }],
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-this-alias": ["error", { "allowDestructuring": true }],
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
        "typescript/no-unused-vars": [
          "error",
          {
            "args": "after-used",
            "argsIgnorePattern": "^_",
            "caughtErrors": "none",
            "ignoreRestSiblings": true,
            "vars": "local",
            "varsIgnorePattern": "^_"
          }
        ],
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-includes": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/triple-slash-reference": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error"
      }
    }
  ]
}
